# Supabase (optional). Leave both URL and service role key empty to run in
# demo mode with data/seed.json and a gitignored .data/db.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL, used in docs/links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
